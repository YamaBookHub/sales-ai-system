{
  "name": "sales-ai-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "ts-node apps/api/src/main.ts",
    "start:dev": "node --watch -r ts-node/register apps/api/src/main.ts",
    "start:worker": "node dist/apps/api/mail-worker.js",
    "test": "jest",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:integration:jest": "jest --config jest.integration.config.js --runInBand",
    "verify": "node scripts/verify.js",
    "release:check": "node scripts/check-production-readiness.js",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "docker:build": "docker build --target runtime --tag sales-ai-system:local .",
    "docker:build:worker": "docker build --target worker --tag sales-ai-system-worker:local .",
    "docker:build:migration": "docker build --target migration --tag sales-ai-system-migration:local .",
    "docker:build:database-ops": "docker build --target database-ops --tag sales-ai-system-database-ops:local .",
    "auth:bootstrap-admin": "ts-node scripts/bootstrap-admin.ts",
    "db:backup": "node scripts/database/backup.js",
    "db:backup:prune": "node scripts/database/prune.js",
    "db:restore": "node scripts/database/restore.js",
    "db:repair-lead-fields": "docker compose exec -T postgres psql -U postgres -d sales_ai_system < prisma/migrations/20260709002000_lead_sales_management/migration.sql",
    "prisma:seed": "ts-node scripts/seed.ts"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "8.3.0",
    "playwright": "^1.49.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  }
}
