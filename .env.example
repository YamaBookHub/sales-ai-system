AI_DEFAULT_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_MAX_DESCRIPTION_CHARS=1200
GEMINI_MAX_OUTPUT_TOKENS=1600
GEMINI_SEMANTIC_CHECK_MAX_OUTPUT_TOKENS=600
GEMINI_FLASH_LITE_INPUT_COST_PER_1M=0.25
GEMINI_FLASH_LITE_OUTPUT_COST_PER_1M=1.50
GEMINI_FLASH_INPUT_COST_PER_1M=1.50
GEMINI_FLASH_OUTPUT_COST_PER_1M=9.00
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_DESCRIPTION_CHARS=1200
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_SEMANTIC_CHECK_MAX_OUTPUT_TOKENS=400
OPENAI_MONTHLY_BUDGET_USD=
OPENAI_ESTIMATED_COST_PER_REQUEST_USD=0.01
OPENAI_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_ai_system
PORT=3000
HOST=127.0.0.1
APP_ENV=local
AUTH_MODE=local
APP_BASE_URL=http://127.0.0.1:3000
AUTH_DEV_USER_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_ORGANIZATION_SLUG=default
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# staging/productionでは32文字以上の値を設定し、複数世代はカンマ区切りにします。
SESSION_SECRETS=
CSRF_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=
GOOGLE_ALLOWED_DOMAINS=
CAMPFIRE_PROFILE_LOOKUP_CONCURRENCY=8
CAMPFIRE_SEARCH_CACHE_TTL_MS=300000
MAIL_SEND_ENABLED=false
MAIL_SENDER_PROVIDER=disabled
MAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
MAIL_SENDER_ORGANIZATION_ID=
MAIL_LEGAL_SENDER_NAME=
MAIL_LEGAL_POSTAL_ADDRESS=
MAIL_LEGAL_CONTACT_EMAIL=
TRACKING_HASH_SECRET=
TRUST_PROXY=false
LEGAL_OPERATOR_NAME=
LEGAL_POSTAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=2026-07-25
TEST_DATABASE_URL=
# DB backup/restore/prune. The key file and output directory must be outside the repository.
BACKUP_OUTPUT_DIR=
BACKUP_ENCRYPTION_KEY_FILE=
BACKUP_KEY_ID=
BACKUP_STORAGE_LABEL=
BACKUP_RETENTION_DAYS=35
BACKUP_MINIMUM_COUNT=7
# Set to the one-time DELETE_<plan-hash> returned by the current prune dry-run.
BACKUP_PRUNE_CONFIRM=
BACKUP_FILE=
BACKUP_MANIFEST_FILE=
RESTORE_TARGET_DATABASE_URL=
RESTORE_TARGET_ENV=
RESTORE_CONFIRM=
# native: pg_dump/pg_restore/psql on PATH. docker-compose: execute them in the postgres service.
DB_OPS_MODE=native
DB_OPS_DOCKER_SERVICE=postgres
DB_OPS_DOCKER_HOST=127.0.0.1
RELEASE_REVISION=
