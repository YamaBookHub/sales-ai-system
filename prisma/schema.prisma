generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  operator
  viewer
}

enum PlatformType {
  campfire
  makuake
  green_funding
  other
}

enum ProjectStatus {
  discovered
  active
  ended
  suspended
  unknown
}

enum ProjectSearchJobStatus {
  running
  completed
  cancelled
  failed
}

enum LeadStatus {
  discovered
  qualified
  drafted
  reviewing
  approved
  queued
  contacted
  replied
  meeting_candidate
  rejected
  no_response
  archived
}

enum LeadPriority {
  high
  medium
  low
}

enum EmailStatus {
  draft
  in_review
  rejected
  approved
  queued
  sending
  sent
  failed
  cancelled
}

enum EmailEventType {
  created
  generated
  reviewed
  rejected
  approved
  queued
  sending
  sent
  failed
  retried
  opened
  clicked
  replied
  unsubscribed
  cancelled
}

enum ReplyCategory {
  interested
  need_info
  meeting_request
  not_interested
  unsubscribe
  auto_reply
  complaint
  unknown
}

enum TaskStatus {
  todo
  doing
  done
  cancelled
}

enum OpportunityStage {
  uncontacted
  contacted
  replied
  meeting
  proposal
  won
  lost
  excluded
}

enum OpportunityLossReason {
  no_interest
  no_budget
  timing
  no_response
  competitor
  service_mismatch
  contact_unavailable
  duplicate
  other
}

enum OpportunityChangeSource {
  manual
  system
  migration
}

enum AiGenerationType {
  lead_scoring
  email_draft
  subject_generation
  reply_classification
  project_summary
  next_action
}

enum LeadAnalysisStatus {
  draft
  confirmed
}

enum LeadAnalysisOrigin {
  generated
  manual
  migration
}

enum AiUsageStatus {
  reserved
  completed
  failed
}

enum AttachmentType {
  proposal_pdf
  lp_url
  video_url
  case_study_url
  other
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  googleSubject String?   @unique
  name          String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  memberships OrganizationMembership[]
  sessions    UserSession[]

  @@index([isActive])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             OrganizationMembership[]
  sessions                UserSession[]
  companies               Company[]
  contacts                ContactPerson[]
  projects                CrowdfundingProject[]
  leads                   SalesLead[]
  leadScores              LeadScore[]
  mails                   OutreachEmail[]
  mailTemplates           MailTemplate[]
  mailChecklistItems      MailChecklistItem[]
  emailEvents             EmailEvent[]
  emailReplies            EmailReply[]
  trackedLinks            TrackedLink[]
  linkClicks              LinkClick[]
  mailAttachments         MailAttachment[]
  aiGenerations           AiGeneration[]
  aiUsageLedgers          AiUsageLedger[]
  leadAnalysisRevisions   LeadAnalysisRevision[]
  tasks                   Task[]
  opportunities           Opportunity[]
  opportunityStageHistory OpportunityStageHistory[]
  auditLogs               AuditLog[]
  projectSearchJobs       ProjectSearchJob[]

  @@index([isActive])
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  displayName    String?
  role           UserRole @default(operator)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions                UserSession[]
  audits                  AuditLog[]                @relation("AuditActorMembership")
  assignedTasks           Task[]                    @relation("TaskAssigneeMembership")
  approvedMails           OutreachEmail[]           @relation("MailApproverMembership")
  ownedOpportunities      Opportunity[]             @relation("OpportunityOwnerMembership")
  opportunityStageChanges OpportunityStageHistory[] @relation("OpportunityStageChangerMembership")
  leadAnalysisChanges     LeadAnalysisRevision[]    @relation("LeadAnalysisChangerMembership")
  projectSearchJobs       ProjectSearchJob[]        @relation("ProjectSearchJobOwner")

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@index([organizationId, role, isActive])
}

model UserSession {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  csrfTokenHash     String
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  ipHash            String?
  userAgentHash     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model CrowdfundingPlatform {
  id        String       @id @default(uuid()) @db.Uuid
  type      PlatformType
  name      String
  baseUrl   String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projects CrowdfundingProject[]

  @@unique([type, baseUrl])
}

model Company {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  name                 String
  normalizedName       String?
  websiteUrl           String?
  inquiryUrl           String?
  industry             String?
  location             String?
  sourceTotalAmount    Int?
  sourceProjectCount   Int?
  sourceSupporterCount Int?
  memo                 String?
  isBlocked            Boolean   @default(false)
  blockedReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     ContactPerson[]
  projects     CrowdfundingProject[]
  leads        SalesLead[]
  mails        OutreachEmail[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, normalizedName])
  @@index([organizationId, isBlocked])
}

model ContactPerson {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String    @db.Uuid
  name           String?
  email          String?
  inquiryUrl     String?
  roleTitle      String?
  isPrimary      Boolean   @default(false)
  isUnsubscribed Boolean   @default(false)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company         @relation(fields: [organizationId, companyId], references: [organizationId, id])
  mails        OutreachEmail[]

  @@unique([organizationId, id])
  @@index([organizationId, companyId])
  @@index([organizationId, email])
  @@index([organizationId, isUnsubscribed])
}

model CrowdfundingProject {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  platformId     String        @db.Uuid
  companyId      String?       @db.Uuid
  title          String
  url            String
  status         ProjectStatus @default(unknown)
  amount         Int           @default(0)
  supporterCount Int           @default(0)
  targetAmount   Int?
  startDate      DateTime?
  endDate        DateTime?
  daysLeft       Int?
  description    String?
  category       String?
  location       String?
  thumbnailUrl   String?
  scrapedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  platform             CrowdfundingPlatform   @relation(fields: [platformId], references: [id])
  company              Company?               @relation(fields: [organizationId, companyId], references: [organizationId, id])
  leads                SalesLead[]
  LeadAnalysisRevision LeadAnalysisRevision[]

  @@unique([organizationId, id])
  @@unique([organizationId, url])
  @@index([organizationId, platformId])
  @@index([organizationId, companyId])
  @@index([organizationId, status])
  @@index([organizationId, amount, supporterCount])
  @@index([organizationId, endDate])
  @@index([organizationId, daysLeft])
  @@index([organizationId, location])
}

model ProjectSearchJob {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  ownerUserId        String                 @db.Uuid
  workerId           String
  status             ProjectSearchJobStatus @default(running)
  source             PlatformType
  request            Json
  desiredLimit       Int
  searchedLimit      Int                    @default(0)
  items              Json
  itemCount          Int                    @default(0)
  importableCount    Int                    @default(0)
  diagnostics        Json?
  completionReason   String?
  message            String
  cancelRequestedAt  DateTime?
  leaseExpiresAt     DateTime
  expiresAt          DateTime
  startedAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        OrganizationMembership  @relation("ProjectSearchJobOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, ownerUserId, updatedAt])
  @@index([status, workerId, cancelRequestedAt, leaseExpiresAt], map: "ProjectSearchJob_status_workerId_cancelRequestedAt_leaseExp_idx")
  @@index([expiresAt])
}

model SalesLead {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  companyId         String       @db.Uuid
  projectId         String?      @db.Uuid
  status            LeadStatus   @default(discovered)
  priority          LeadPriority @default(medium)
  score             Int          @default(0)
  reason            String?
  source            String       @default("manual")
  ownerMemo         String?
  contactEmail      String?
  contactFormUrl    String?
  siteMessageUrl    String?
  contactMemo       String?
  sendMethod        String?
  sentAt            DateTime?
  nextFollowUpAt    DateTime?
  brandWebsiteUrl   String?
  instagramUrl      String?
  tiktokUrl         String?
  xUrl              String?
  brandAnalysisMemo String?
  snsAnalysisMemo   String?
  nextActionAt      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company           Company                @relation(fields: [organizationId, companyId], references: [organizationId, id])
  project           CrowdfundingProject?   @relation(fields: [organizationId, projectId], references: [organizationId, id])
  mails             OutreachEmail[]
  tasks             Task[]
  scores            LeadScore[]
  aiGenerations     AiGeneration[]
  analysisRevisions LeadAnalysisRevision[]
  opportunity       Opportunity?

  @@unique([organizationId, id])
  @@unique([organizationId, companyId, projectId])
  @@index([organizationId, status, priority])
  @@index([organizationId, score])
  @@index([organizationId, nextActionAt])
}

model LeadScore {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  amountScore    Int      @default(0)
  supporterScore Int      @default(0)
  urgencyScore   Int      @default(0)
  fitScore       Int      @default(0)
  activityScore  Int      @default(0)
  totalScore     Int      @default(0)
  reasonJson     Json?
  version        String   @default("v1")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         SalesLead    @relation(fields: [organizationId, leadId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, leadId])
  @@index([organizationId, totalScore])
}

model OutreachEmail {
  id                 String      @id @default(uuid()) @db.Uuid
  openTrackingToken  String      @unique @default(uuid()) @db.Uuid
  unsubscribeToken   String      @unique @default(uuid()) @db.Uuid
  organizationId     String      @db.Uuid
  leadId             String?     @db.Uuid
  companyId          String      @db.Uuid
  contactId          String?     @db.Uuid
  approvedById       String?     @db.Uuid
  analysisRevisionId String?     @db.Uuid
  status             EmailStatus @default(draft)
  templateKey        String?
  subject            String
  body               String
  bodyHtml           String?
  toEmail            String?
  destinationType    String?
  destinationValue   String?
  destinationKey     String?
  ccEmails           String[]    @default([])
  bccEmails          String[]    @default([])
  gmailMessageId     String?
  gmailThreadId      String?
  provider           String      @default("gmail")
  scheduledAt        DateTime?
  sentAt             DateTime?
  approvedAt         DateTime?
  failedReason       String?
  retryCount         Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead             SalesLead?              @relation(fields: [organizationId, leadId], references: [organizationId, id])
  company          Company                 @relation(fields: [organizationId, companyId], references: [organizationId, id])
  contact          ContactPerson?          @relation(fields: [organizationId, contactId], references: [organizationId, id])
  approvedBy       OrganizationMembership? @relation("MailApproverMembership", fields: [organizationId, approvedById], references: [organizationId, userId])
  analysisRevision LeadAnalysisRevision?   @relation(fields: [organizationId, analysisRevisionId], references: [organizationId, id])
  events           EmailEvent[]
  replies          EmailReply[]
  links            TrackedLink[]
  attachments      MailAttachment[]
  aiGenerations    AiGeneration[]
  checklistItems   MailChecklistItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, gmailMessageId])
  @@index([organizationId, status])
  @@index([organizationId, leadId])
  @@index([organizationId, companyId])
  @@index([organizationId, analysisRevisionId])
  @@index([organizationId, destinationKey, status])
  @@index([organizationId, gmailThreadId])
  @@index([organizationId, scheduledAt])
}

model MailTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  name           String
  channel        String   @default("email")
  subject        String?
  body           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, channel, isActive])
}

model MailChecklistItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  emailId        String    @db.Uuid
  key            String
  label          String
  checked        Boolean   @default(false)
  checkedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email        OutreachEmail @relation(fields: [organizationId, emailId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, emailId, key])
  @@index([organizationId, emailId])
  @@index([organizationId, checked])
}

model EmailEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  emailId        String         @db.Uuid
  type           EmailEventType
  payload        Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email        OutreachEmail @relation(fields: [organizationId, emailId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, emailId, type])
  @@index([organizationId, createdAt])
}

model EmailReply {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  emailId        String        @db.Uuid
  gmailMessageId String?
  fromEmail      String?
  body           String
  bodyText       String?
  category       ReplyCategory @default(unknown)
  confidence     Float         @default(0)
  summary        String?
  nextAction     String?
  receivedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email        OutreachEmail @relation(fields: [organizationId, emailId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@unique([organizationId, gmailMessageId])
  @@index([organizationId, emailId])
  @@index([organizationId, category])
  @@index([organizationId, receivedAt])
}

model TrackedLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  emailId        String   @db.Uuid
  token          String   @unique
  originalUrl    String
  label          String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email        OutreachEmail @relation(fields: [organizationId, emailId], references: [organizationId, id])
  clicks       LinkClick[]

  @@unique([organizationId, id])
  @@index([organizationId, emailId])
}

model LinkClick {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  linkId         String   @db.Uuid
  ipHash         String?
  userAgent      String?
  referer        String?
  fingerprintHash String?
  isBot          Boolean  @default(false)
  clickedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  link         TrackedLink  @relation(fields: [organizationId, linkId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, linkId])
  @@index([organizationId, linkId, fingerprintHash, clickedAt])
  @@index([organizationId, clickedAt])
}

model MailAttachment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  emailId        String         @db.Uuid
  type           AttachmentType @default(other)
  name           String
  url            String
  mimeType       String?
  sizeBytes      Int?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email        OutreachEmail @relation(fields: [organizationId, emailId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, emailId])
  @@index([organizationId, type])
}

model AiGeneration {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  leadId         String?          @db.Uuid
  emailId        String?          @db.Uuid
  type           AiGenerationType
  provider       String
  model          String
  promptVersion  String
  inputJson      Json
  outputJson     Json
  latencyMs      Int?
  tokenInput     Int?
  tokenOutput    Int?
  costUsd        Decimal?         @db.Decimal(12, 6)
  createdAt      DateTime         @default(now())

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead              SalesLead?             @relation(fields: [organizationId, leadId], references: [organizationId, id])
  email             OutreachEmail?         @relation(fields: [organizationId, emailId], references: [organizationId, id])
  analysisRevisions LeadAnalysisRevision[]

  @@unique([organizationId, id])
  @@index([organizationId, type])
  @@index([organizationId, leadId])
  @@index([organizationId, emailId])
  @@index([organizationId, createdAt])
}

model AiUsageLedger {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  provider         String
  model            String
  operation        String
  status           AiUsageStatus @default(reserved)
  estimatedCostUsd Decimal       @db.Decimal(12, 6)
  actualCostUsd    Decimal?      @db.Decimal(12, 6)
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, provider, createdAt, status])
}

model LeadAnalysisRevision {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  leadId             String             @db.Uuid
  projectId          String             @db.Uuid
  sourceGenerationId String?            @db.Uuid
  changedById        String?            @db.Uuid
  version            Int
  status             LeadAnalysisStatus @default(draft)
  origin             LeadAnalysisOrigin
  appeal             String?
  targetUser         String?
  videoIdea          String?
  sourceFingerprint  String
  generatedAt        DateTime?
  confirmedAt        DateTime?
  humanEdited        Boolean            @default(false)
  editedFields       String[]           @default([])
  createdAt          DateTime           @default(now())

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead             SalesLead               @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  project          CrowdfundingProject     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  sourceGeneration AiGeneration?           @relation(fields: [organizationId, sourceGenerationId], references: [organizationId, id])
  changedBy        OrganizationMembership? @relation("LeadAnalysisChangerMembership", fields: [organizationId, changedById], references: [organizationId, userId])
  emails           OutreachEmail[]

  @@unique([organizationId, id])
  @@unique([organizationId, leadId, version])
  @@index([organizationId, leadId, status, version])
  @@index([organizationId, projectId])
  @@index([organizationId, sourceGenerationId])
  @@index([organizationId, changedById])
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  leadId         String?    @db.Uuid
  assigneeId     String?    @db.Uuid
  title          String
  description    String?
  status         TaskStatus @default(todo)
  dueAt          DateTime?
  doneAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         SalesLead?              @relation(fields: [organizationId, leadId], references: [organizationId, id])
  assignee     OrganizationMembership? @relation("TaskAssigneeMembership", fields: [organizationId, assigneeId], references: [organizationId, userId])

  @@unique([organizationId, id])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, leadId])
  @@index([organizationId, assigneeId])
}

model Opportunity {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  leadId             String                 @db.Uuid
  ownerId            String?                @db.Uuid
  stage              OpportunityStage       @default(uncontacted)
  probability        Int                    @default(0)
  expectedAmount     Int?
  wonAmount          Int?
  meetingScheduledAt DateTime?
  expectedCloseDate  DateTime?
  wonAt              DateTime?
  lostAt             DateTime?
  lossReason         OpportunityLossReason?
  lossReasonDetail   String?
  stageChangedAt     DateTime               @default(now())
  version            Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         SalesLead                 @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  owner        OrganizationMembership?   @relation("OpportunityOwnerMembership", fields: [organizationId, ownerId], references: [organizationId, userId])
  history      OpportunityStageHistory[]

  @@unique([organizationId, id])
  @@unique([organizationId, leadId])
  @@index([organizationId, stage, updatedAt])
  @@index([organizationId, ownerId, stage])
  @@index([organizationId, expectedCloseDate])
}

model OpportunityStageHistory {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  opportunityId  String                  @db.Uuid
  fromStage      OpportunityStage?
  toStage        OpportunityStage
  changedById    String?                 @db.Uuid
  source         OpportunityChangeSource @default(manual)
  sourceId       String?
  reason         String?
  operationKey   String?
  versionAfter   Int
  snapshot       Json?
  createdAt      DateTime                @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  Opportunity             @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: Cascade)
  changedBy    OrganizationMembership? @relation("OpportunityStageChangerMembership", fields: [organizationId, changedById], references: [organizationId, userId])

  @@unique([organizationId, id])
  @@unique([organizationId, operationKey])
  @@index([organizationId, opportunityId, createdAt])
  @@index([organizationId, toStage, createdAt])
  @@index([organizationId, changedById, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  sessionId      String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        OrganizationMembership? @relation("AuditActorMembership", fields: [organizationId, userId], references: [organizationId, userId])
  session      UserSession?            @relation(fields: [organizationId, sessionId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action])
  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, sessionId, createdAt])
  @@index([organizationId, action, createdAt])
}
